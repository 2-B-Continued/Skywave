#!/usr/bin/env python3
# Stand-in for meteor_decode used by tests: writes a composite and split-channel pictures.
import sys, random
from PIL import Image, ImageFilter
a = sys.argv[1:]
out = a[a.index("-o") + 1]
base = out[:-4]
W, H = 1568, 2600
random.seed(3)
def make(seed):
    im = Image.effect_noise((W // 8, H // 8), 60).resize((W, H), Image.BICUBIC).filter(ImageFilter.GaussianBlur(6))
    return im
for p in (10, 60, 100):
    print(" %.2f%%    vit(avg): 1100 rs(sum): %d       APID 64" % (p, 3 if p == 100 else 0), flush=True)
c = Image.merge("RGB", (make(1), make(2), make(3)))
c.save(out)
for apid in (64, 65, 68):
    make(apid).save("%s_%d.png" % (base, apid))
